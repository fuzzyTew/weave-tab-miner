 pkg-randomwow.js-shared/vm.wasm: pkg-randomwow.js/vm.wasm
 	cp $< $@
+
+# ---- Arweave H0 variant ("rx4096" in apps/arweave/lib/Makefile) ----
+# Arweave's fork uses the same 4-round AES generator keys as RandomWOW (aes4r_wow.c),
+# with its own configuration.toml for salt, cache, dataset sizes and instruction frequencies.
+pkg-randomx-arweave.js/dataset.wasm: $(DATASET_C_SOURCES) $(H_SOURCES)
+	clang -O3 $(CFLAGS) $(LDFLAGS) \
+		-Wl,--import-memory \
+		-o $@ $(DATASET_C_SOURCES) \
+		$(shell scripts/deflist.ts pkg-randomx-arweave.js/configuration.toml)
+
+	scripts/nogrowablepatch.ts $@ '\x03env\x06memory'
+	wasm-strip $@
+	wasm-opt -all -O4 -Oz $@ -o $@
+
+pkg-randomx-arweave.js/vm.wasm: $(VM_SINGLE_WOW_C_SOURCES) $(H_SOURCES)
+	clang -O3 $(CFLAGS) $(LDFLAGS) \
+		-Wl,--import-memory \
+		-o $@ $(VM_SINGLE_WOW_C_SOURCES) \
+		$(shell scripts/deflist.ts pkg-randomx-arweave.js/configuration.toml)
+
+	scripts/nogrowablepatch.ts $@ '\x03env\x06memory'
+	wasm-strip $@
+	wasm-opt -all -O4 -Oz $@ -o $@
+
+# Arweave replica 2.9 packing entropy ("RandomX squared", apps/arweave/c_src/randomx/randomx_squared.cpp)
+VM_RX2_C_SOURCES := $(sort $(VM_WOW_C_SOURCES) src/vm_rx2/vm.c)
+
+pkg-randomx-arweave.js/rx2vm.wasm: $(VM_RX2_C_SOURCES) $(H_SOURCES)
+	clang -O3 $(CFLAGS) $(LDFLAGS) \
+		-Wl,--import-memory \
+		-o $@ $(VM_RX2_C_SOURCES) \
+		$(shell scripts/deflist.ts pkg-randomx-arweave.js/configuration-squared.toml)
+
+	scripts/nogrowablepatch.ts $@ '\x03env\x06memory'
+	wasm-strip $@
+	wasm-opt -all -O4 -Oz $@ -o $@
